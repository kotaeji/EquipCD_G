<?xml version="1.0" encoding="UTF-8"?>
<!-- Equipment Concept Designer sample asset library (prototype). Values are [예시] assumptions, not real device specs. -->
<!-- "ECD.AppExtension" attributes are an application-specific extension; they carry NO AutomationML standard semantics. -->
<CAEXFile xmlns="http://www.dke.de/CAEX" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.dke.de/CAEX CAEX_ClassModel_V.3.0.xsd" SchemaVersion="2.15" FileName="ecd-sample-library.aml">
  <SuperiorStandardVersion>AutomationML 2.10</SuperiorStandardVersion>
  <SourceDocumentInformation OriginName="Equipment Concept Designer (web prototype)" OriginID="ecd-web-prototype" OriginVersion="0.2.0" LastWritingDateTime="2026-11-08T00:00:00Z" OriginVendor="prototype (unreleased)" OriginProjectTitle="equipment-concept-prototype" OriginProjectID="unspecified" />
  <InterfaceClassLib Name="AutomationMLInterfaceClassLib">
    <Description>EXCERPT (subset) of the AutomationML standard interface class library (structure as published by AutomationML e.V. example models, version 2.10.0). Not the complete library.</Description>
    <Version>2.10.0</Version>
    <InterfaceClass Name="AutomationMLBaseInterface">
      <InterfaceClass Name="Port" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface" />
      <InterfaceClass Name="ExternalDataConnector" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI" />
        <InterfaceClass Name="ExternalDataReference" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector">
          <Attribute Name="MIMEType" AttributeDataType="xs:string" />
        </InterfaceClass>
      </InterfaceClass>
      <InterfaceClass Name="Communication" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface">
        <InterfaceClass Name="SignalInterface" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/Communication" />
      </InterfaceClass>
    </InterfaceClass>
  </InterfaceClassLib>
  <InterfaceClassLib Name="ECD_InterfaceClassLib">
    <Description>Prototype interface classes. ConceptSignal = role-based conceptual boolean signal (no real I/O address).</Description>
    <Version>0.1.0</Version>
    <InterfaceClass Name="ConceptSignal" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/Communication/SignalInterface">
      <Attribute Name="Direction" AttributeDataType="xs:string" />
      <Attribute Name="SignalRole" AttributeDataType="xs:string" />
      <Attribute Name="ValueType" AttributeDataType="xs:string" />
    </InterfaceClass>
    <InterfaceClass Name="MaterialFlowPort" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface">
      <Attribute Name="Direction" AttributeDataType="xs:string" />
    </InterfaceClass>
  </InterfaceClassLib>
  <RoleClassLib Name="AutomationMLBaseRoleClassLib">
    <Description>EXCERPT (subset) of the AutomationML base role class library (version 2.10.0). Not the complete library.</Description>
    <Version>2.10.0</Version>
    <RoleClass Name="AutomationMLBaseRole">
      <RoleClass Name="Resource" RefBaseClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole" />
    </RoleClass>
  </RoleClassLib>
  <RoleClassLib Name="ECD_RoleClassLib">
    <Version>0.1.0</Version>
    <RoleClass Name="AxisDevice" RefBaseClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Resource"><Description>축/구동 장치</Description></RoleClass>
    <RoleClass Name="IODevice" RefBaseClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Resource"><Description>I/O 장치</Description></RoleClass>
    <RoleClass Name="SensorDevice" RefBaseClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Resource"><Description>센서·식별 장치</Description></RoleClass>
    <RoleClass Name="TransportDevice" RefBaseClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Resource"><Description>이송 장치</Description></RoleClass>
    <RoleClass Name="EquipmentUnit" RefBaseClassPath="AutomationMLBaseRoleClassLib/AutomationMLBaseRole/Resource"><Description>복합 유닛(장치 묶음)</Description></RoleClass>
  </RoleClassLib>
  <SystemUnitClassLib Name="ECD_SampleAssetLib">
    <Description>Sample assets of the Equipment Concept Designer prototype. All numbers are [예시] assumptions.</Description>
    <Version>0.1.0</Version>
    <SystemUnitClass Name="cylinder" ID="asset.cylinder">
      <Description>실린더</Description>
      <Version>0.1.0</Version>
      <Attribute Name="stroke" AttributeDataType="xs:double" Unit="mm">
        <Description>스트로크</Description>
        <DefaultValue>100</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="moveTime" AttributeDataType="xs:double" Unit="s">
        <Description>이동 시간</Description>
        <DefaultValue>0.8</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="ECD.AppExtension">
        <Description>Application-specific extension of Equipment Concept Designer (category, naming, actions/simulation timing, template layout/rules). Not AutomationML standard semantics.</Description>
        <Attribute Name="Category" AttributeDataType="xs:string"><Value>axis</Value></Attribute>
        <Attribute Name="NamePrefix" AttributeDataType="xs:string"><Value>CYL</Value></Attribute>
        <Attribute Name="Actions">
          <Attribute Name="extend">
            <Attribute Name="Label" AttributeDataType="xs:string"><Value>전진</Value></Attribute>
            <Attribute Name="Kind" AttributeDataType="xs:string"><Value>extend</Value></Attribute>
            <Attribute Name="CommandPort" AttributeDataType="xs:string"><Value>cmdFwd</Value></Attribute>
            <Attribute Name="CompletePort" AttributeDataType="xs:string"><Value>fwdDone</Value></Attribute>
            <Attribute Name="DurationS" AttributeDataType="xs:double" Unit="s"><Value>0.8</Value></Attribute>
            <Attribute Name="TimeoutS" AttributeDataType="xs:double" Unit="s"><Value>3</Value></Attribute>
          </Attribute>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="cmdFwd" ID="asset.cylinder.cmdFwd" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>전진 명령</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="fwdDone" ID="asset.cylinder.fwdDone" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>전진 완료</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>complete</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="Schematic" ID="asset.cylinder.Schematic" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/schematic/cylinder.svg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/svg+xml</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.cylinder.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/photos/cyl.jpg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/jpeg</Value></Attribute>
        <Attribute Name="ECD.PhotoMatchType" AttributeDataType="xs:string"><Value>class-reference</Value></Attribute>
        <Attribute Name="ECD.ExactModelMatch" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
        <Attribute Name="ECD.ScopeNote" AttributeDataType="xs:string"><Value>참고 사진·실제 촬영·모델/사양 일치 보장 안 함. 공압 실린더 2개 제품 실사진.</Value></Attribute>
      </ExternalInterface>
      <SupportedRoleClass RefRoleClassPath="ECD_RoleClassLib/AxisDevice" />
    </SystemUnitClass>
    <SystemUnitClass Name="pusher" ID="asset.pusher">
      <Description>푸셔</Description>
      <Version>0.1.0</Version>
      <Attribute Name="stroke" AttributeDataType="xs:double" Unit="mm">
        <Description>푸시 스트로크</Description>
        <DefaultValue>150</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="pushTime" AttributeDataType="xs:double" Unit="s">
        <Description>푸시 시간</Description>
        <DefaultValue>0.8</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="ECD.AppExtension">
        <Description>Application-specific extension of Equipment Concept Designer (category, naming, actions/simulation timing, template layout/rules). Not AutomationML standard semantics.</Description>
        <Attribute Name="Category" AttributeDataType="xs:string"><Value>axis</Value></Attribute>
        <Attribute Name="NamePrefix" AttributeDataType="xs:string"><Value>PSH</Value></Attribute>
        <Attribute Name="Actions">
          <Attribute Name="push">
            <Attribute Name="Label" AttributeDataType="xs:string"><Value>푸시</Value></Attribute>
            <Attribute Name="Kind" AttributeDataType="xs:string"><Value>extend</Value></Attribute>
            <Attribute Name="CommandPort" AttributeDataType="xs:string"><Value>cmdPush</Value></Attribute>
            <Attribute Name="CompletePort" AttributeDataType="xs:string"><Value>pushDone</Value></Attribute>
            <Attribute Name="DurationS" AttributeDataType="xs:double" Unit="s"><Value>0.8</Value></Attribute>
            <Attribute Name="TimeoutS" AttributeDataType="xs:double" Unit="s"><Value>3</Value></Attribute>
          </Attribute>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="cmdPush" ID="asset.pusher.cmdPush" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>푸시 명령</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="pushDone" ID="asset.pusher.pushDone" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>푸시 완료</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>complete</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="Schematic" ID="asset.pusher.Schematic" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/schematic/pusher.svg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/svg+xml</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.pusher.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/photos/cyl.jpg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/jpeg</Value></Attribute>
        <Attribute Name="ECD.PhotoMatchType" AttributeDataType="xs:string"><Value>component-reference</Value></Attribute>
        <Attribute Name="ECD.ExactModelMatch" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
        <Attribute Name="ECD.ScopeNote" AttributeDataType="xs:string"><Value>참고 사진·실제 촬영·모델/사양 일치 보장 안 함. 구성요소 참고사진(실린더), 푸셔 조립체 사진 아님.</Value></Attribute>
      </ExternalInterface>
      <SupportedRoleClass RefRoleClassPath="ECD_RoleClassLib/AxisDevice" />
    </SystemUnitClass>
    <SystemUnitClass Name="barcodeReader" ID="asset.barcodeReader">
      <Description>바코드리더</Description>
      <Version>0.1.0</Version>
      <Attribute Name="readTime" AttributeDataType="xs:double" Unit="s">
        <Description>읽기 시간</Description>
        <DefaultValue>0.5</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="ECD.AppExtension">
        <Description>Application-specific extension of Equipment Concept Designer (category, naming, actions/simulation timing, template layout/rules). Not AutomationML standard semantics.</Description>
        <Attribute Name="Category" AttributeDataType="xs:string"><Value>sensor</Value></Attribute>
        <Attribute Name="NamePrefix" AttributeDataType="xs:string"><Value>BCR</Value></Attribute>
        <Attribute Name="Actions">
          <Attribute Name="read">
            <Attribute Name="Label" AttributeDataType="xs:string"><Value>읽기</Value></Attribute>
            <Attribute Name="Kind" AttributeDataType="xs:string"><Value>read</Value></Attribute>
            <Attribute Name="CommandPort" AttributeDataType="xs:string"><Value>trigger</Value></Attribute>
            <Attribute Name="CompletePort" AttributeDataType="xs:string"><Value>readDone</Value></Attribute>
            <Attribute Name="DurationS" AttributeDataType="xs:double" Unit="s"><Value>0.5</Value></Attribute>
            <Attribute Name="TimeoutS" AttributeDataType="xs:double" Unit="s"><Value>2</Value></Attribute>
          </Attribute>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="trigger" ID="asset.barcodeReader.trigger" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>읽기 트리거</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="readDone" ID="asset.barcodeReader.readDone" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>읽기 완료</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>complete</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="readOk" ID="asset.barcodeReader.readOk" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>읽기 결과 OK</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>result</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="Schematic" ID="asset.barcodeReader.Schematic" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/schematic/barcodeReader.svg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/svg+xml</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.barcodeReader.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/photos/bcr.jpg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/jpeg</Value></Attribute>
        <Attribute Name="ECD.PhotoMatchType" AttributeDataType="xs:string"><Value>class-reference</Value></Attribute>
        <Attribute Name="ECD.ExactModelMatch" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
        <Attribute Name="ECD.ScopeNote" AttributeDataType="xs:string"><Value>참고 사진·실제 촬영·모델/사양 일치 보장 안 함. Honeywell 4600g 핸드헬드 바코드 스캐너 실사진. 고정식(설비 장착형) 리더가 아님.</Value></Attribute>
      </ExternalInterface>
      <SupportedRoleClass RefRoleClassPath="ECD_RoleClassLib/SensorDevice" />
    </SystemUnitClass>
    <SystemUnitClass Name="conveyor" ID="asset.conveyor">
      <Description>컨베이어</Description>
      <Version>0.1.0</Version>
      <Attribute Name="length" AttributeDataType="xs:double" Unit="mm">
        <Description>길이</Description>
        <DefaultValue>600</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
      </Attribute>
      <Attribute Name="speed" AttributeDataType="xs:double" Unit="mm/s">
        <Description>속도</Description>
        <DefaultValue>300</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="ECD.AppExtension">
        <Description>Application-specific extension of Equipment Concept Designer (category, naming, actions/simulation timing, template layout/rules). Not AutomationML standard semantics.</Description>
        <Attribute Name="Category" AttributeDataType="xs:string"><Value>transport</Value></Attribute>
        <Attribute Name="NamePrefix" AttributeDataType="xs:string"><Value>CNV</Value></Attribute>
        <Attribute Name="Actions">
          <Attribute Name="convey">
            <Attribute Name="Label" AttributeDataType="xs:string"><Value>이송</Value></Attribute>
            <Attribute Name="Kind" AttributeDataType="xs:string"><Value>convey</Value></Attribute>
            <Attribute Name="CommandPort" AttributeDataType="xs:string"><Value>run</Value></Attribute>
            <Attribute Name="CompletePort" AttributeDataType="xs:string"><Value>exitSensor</Value></Attribute>
            <Attribute Name="DurationS" AttributeDataType="xs:double" Unit="s"><Value>2</Value></Attribute>
            <Attribute Name="TimeoutS" AttributeDataType="xs:double" Unit="s"><Value>5</Value></Attribute>
          </Attribute>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="run" ID="asset.conveyor.run" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>구동 명령</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="exitSensor" ID="asset.conveyor.exitSensor" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>배출 감지</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>complete</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="Schematic" ID="asset.conveyor.Schematic" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/schematic/conveyor.svg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/svg+xml</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.conveyor.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/photos/conv.jpg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/jpeg</Value></Attribute>
        <Attribute Name="ECD.PhotoMatchType" AttributeDataType="xs:string"><Value>class-reference</Value></Attribute>
        <Attribute Name="ECD.ExactModelMatch" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
        <Attribute Name="ECD.ScopeNote" AttributeDataType="xs:string"><Value>참고 사진·실제 촬영·모델/사양 일치 보장 안 함. 공장 내 벨트·롤러 컨베이어 시스템 실사진 (Pixabay 원본, CC0).</Value></Attribute>
      </ExternalInterface>
      <SupportedRoleClass RefRoleClassPath="ECD_RoleClassLib/TransportDevice" />
    </SystemUnitClass>
    <SystemUnitClass Name="stopper" ID="asset.stopper">
      <Description>스토퍼</Description>
      <Version>0.1.0</Version>
      <Attribute Name="actTime" AttributeDataType="xs:double" Unit="s">
        <Description>동작 시간</Description>
        <DefaultValue>0.3</DefaultValue>
        <Attribute Name="ECD.requiredForRun" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
      </Attribute>
      <Attribute Name="ECD.AppExtension">
        <Description>Application-specific extension of Equipment Concept Designer (category, naming, actions/simulation timing, template layout/rules). Not AutomationML standard semantics.</Description>
        <Attribute Name="Category" AttributeDataType="xs:string"><Value>io</Value></Attribute>
        <Attribute Name="NamePrefix" AttributeDataType="xs:string"><Value>STP</Value></Attribute>
        <Attribute Name="Actions">
          <Attribute Name="raise">
            <Attribute Name="Label" AttributeDataType="xs:string"><Value>상승(정지)</Value></Attribute>
            <Attribute Name="Kind" AttributeDataType="xs:string"><Value>raise</Value></Attribute>
            <Attribute Name="CommandPort" AttributeDataType="xs:string"><Value>cmdUp</Value></Attribute>
            <Attribute Name="CompletePort" AttributeDataType="xs:string"><Value>upDone</Value></Attribute>
            <Attribute Name="DurationS" AttributeDataType="xs:double" Unit="s"><Value>0.3</Value></Attribute>
            <Attribute Name="TimeoutS" AttributeDataType="xs:double" Unit="s"><Value>1.5</Value></Attribute>
          </Attribute>
          <Attribute Name="lower">
            <Attribute Name="Label" AttributeDataType="xs:string"><Value>하강(해제)</Value></Attribute>
            <Attribute Name="Kind" AttributeDataType="xs:string"><Value>lower</Value></Attribute>
            <Attribute Name="CommandPort" AttributeDataType="xs:string"><Value>cmdDown</Value></Attribute>
            <Attribute Name="CompletePort" AttributeDataType="xs:string"><Value>downDone</Value></Attribute>
            <Attribute Name="DurationS" AttributeDataType="xs:double" Unit="s"><Value>0.3</Value></Attribute>
            <Attribute Name="TimeoutS" AttributeDataType="xs:double" Unit="s"><Value>1.5</Value></Attribute>
          </Attribute>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="cmdUp" ID="asset.stopper.cmdUp" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>상승 명령</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="upDone" ID="asset.stopper.upDone" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>상승 완료</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>complete</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="cmdDown" ID="asset.stopper.cmdDown" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>하강 명령</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="downDone" ID="asset.stopper.downDone" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
        <Description>하강 완료</Description>
        <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
        <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>complete</Value></Attribute>
        <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="Schematic" ID="asset.stopper.Schematic" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/schematic/stopper.svg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/svg+xml</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.stopper.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/photos/cyl.jpg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/jpeg</Value></Attribute>
        <Attribute Name="ECD.PhotoMatchType" AttributeDataType="xs:string"><Value>component-reference</Value></Attribute>
        <Attribute Name="ECD.ExactModelMatch" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
        <Attribute Name="ECD.ScopeNote" AttributeDataType="xs:string"><Value>참고 사진·실제 촬영·모델/사양 일치 보장 안 함. 구성요소 참고사진(실린더), 스토퍼 조립체 사진 아님.</Value></Attribute>
      </ExternalInterface>
      <SupportedRoleClass RefRoleClassPath="ECD_RoleClassLib/IODevice" />
    </SystemUnitClass>
