      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.unitIdentify.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
