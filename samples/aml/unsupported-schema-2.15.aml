          <Attribute Name="H" AttributeDataType="xs:double"><Value>300</Value></Attribute>
        </Attribute>
        <Attribute Name="TemplateRules">
          <Attribute Name="Rule1">
            <Attribute Name="Child" AttributeDataType="xs:string"><Value>BCR1</Value></Attribute>
            <Attribute Name="Action" AttributeDataType="xs:string"><Value>read</Value></Attribute>
            <Attribute Name="Pre1">
              <Attribute Name="Child" AttributeDataType="xs:string"><Value>STP1</Value></Attribute>
