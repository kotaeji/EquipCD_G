          <Attribute Name="Y" AttributeDataType="xs:double"><Value>200</Value></Attribute>
        </Attribute>
        <ExternalInterface Name="cmdUp" ID="asset.unitIdentify.STP1.cmdUp" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
          <Description>상승 명령</Description>
          <Attribute Name="Direction" AttributeDataType="xs:string"><Value>in</Value></Attribute>
          <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>command</Value></Attribute>
