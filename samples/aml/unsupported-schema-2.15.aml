    <SystemUnitClass Name="unitInput" ID="asset.unitInput">
      <Description>투입 유닛 템플릿</Description>
      <Version>0.1.0</Version>
      <Attribute Name="ECD.AppExtension">
        <Description>Application-specific extension of Equipment Concept Designer (category, naming, actions/simulation timing, template layout/rules). Not AutomationML standard semantics.</Description>
        <Attribute Name="Category" AttributeDataType="xs:string"><Value>unit</Value></Attribute>
        <Attribute Name="NamePrefix" AttributeDataType="xs:string"><Value>UIN</Value></Attribute>
        <Attribute Name="TemplateLayout">
          <Attribute Name="W" AttributeDataType="xs:double"><Value>216</Value></Attribute>
          <Attribute Name="H" AttributeDataType="xs:double"><Value>300</Value></Attribute>
        </Attribute>
        <Attribute Name="TemplateRules">
          <Attribute Name="Rule1">
            <Attribute Name="Child" AttributeDataType="xs:string"><Value>PSH1</Value></Attribute>
            <Attribute Name="Action" AttributeDataType="xs:string"><Value>push</Value></Attribute>
            <Attribute Name="Pre1">
              <Attribute Name="Child" AttributeDataType="xs:string"><Value>PES1</Value></Attribute>
              <Attribute Name="Port" AttributeDataType="xs:string"><Value>detect</Value></Attribute>
              <Attribute Name="Equals" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
            </Attribute>
          </Attribute>
          <Attribute Name="Rule2">
            <Attribute Name="Child" AttributeDataType="xs:string"><Value>CYL1</Value></Attribute>
            <Attribute Name="Action" AttributeDataType="xs:string"><Value>extend</Value></Attribute>
            <Attribute Name="Pre1">
              <Attribute Name="Child" AttributeDataType="xs:string"><Value>PSH1</Value></Attribute>
              <Attribute Name="Port" AttributeDataType="xs:string"><Value>pushDone</Value></Attribute>
              <Attribute Name="Equals" AttributeDataType="xs:boolean"><Value>true</Value></Attribute>
            </Attribute>
          </Attribute>
        </Attribute>
      </Attribute>
      <ExternalInterface Name="Schematic" ID="asset.unitInput.Schematic" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/schematic/unitInput.svg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/svg+xml</Value></Attribute>
      </ExternalInterface>
      <ExternalInterface Name="ReferencePhoto" ID="asset.unitInput.ReferencePhoto" RefBaseClassPath="AutomationMLInterfaceClassLib/AutomationMLBaseInterface/ExternalDataConnector/ExternalDataReference">
        <Attribute Name="refURI" AttributeDataType="xs:anyURI"><Value>../visuals/photos/belt.jpg</Value></Attribute>
        <Attribute Name="MIMEType" AttributeDataType="xs:string"><Value>image/jpeg</Value></Attribute>
        <Attribute Name="ECD.PhotoMatchType" AttributeDataType="xs:string"><Value>assembly-reference</Value></Attribute>
        <Attribute Name="ECD.ExactModelMatch" AttributeDataType="xs:boolean"><Value>false</Value></Attribute>
        <Attribute Name="ECD.ScopeNote" AttributeDataType="xs:string"><Value>참고 사진·실제 촬영·모델/사양 일치 보장 안 함. 참고 구조: 투입/이송용 수평 벨트 컨베이어 라인 실사진. 본 앱 예시 투입 유닛의 실사진 아님.</Value></Attribute>
      </ExternalInterface>
      <InternalElement Name="PES1" ID="asset.unitInput.PES1" RefBaseSystemUnitPath="ECD_SampleAssetLib/photoelectricSensor">
        <Description>투입 자재 감지</Description>
        <Attribute Name="ECD.AppExtension.LayoutOffset">
          <Attribute Name="X" AttributeDataType="xs:double"><Value>150</Value></Attribute>
          <Attribute Name="Y" AttributeDataType="xs:double"><Value>40</Value></Attribute>
        </Attribute>
        <ExternalInterface Name="detect" ID="asset.unitInput.PES1.detect" RefBaseClassPath="ECD_InterfaceClassLib/ConceptSignal">
          <Description>광 검출(자재 있음)</Description>
          <Attribute Name="Direction" AttributeDataType="xs:string"><Value>out</Value></Attribute>
          <Attribute Name="SignalRole" AttributeDataType="xs:string"><Value>sensor</Value></Attribute>
          <Attribute Name="ValueType" AttributeDataType="xs:string"><Value>xs:boolean</Value></Attribute>
        </ExternalInterface>
      </InternalElement>
      <InternalElement Name="PSH1" ID="asset.unitInput.PSH1" RefBaseSystemUnitPath="ECD_SampleAssetLib/pusher">
        <Description>투입 푸셔</Description>
        <Attribute Name="ECD.AppExtension.LayoutOffset">
          <Attribute Name="X" AttributeDataType="xs:double"><Value>20</Value></Attribute>
