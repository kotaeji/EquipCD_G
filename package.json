{
  "name": "equipment-concept-designer-prototype",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Equipment Concept Designer - web prototype (logic simulation only, not equipment control)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/copy-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:samples": "vite-node scripts/gen-samples.ts",
    "package:src": "node scripts/package-src.mjs",
    "gen:aml": "vite-node scripts/gen-aml.ts",
    "validate:aml": "python3 scripts/validate-aml.py"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "^5.2.8",
    "@xyflow/react": "^12.12.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "fast-xml-parser": "^5.12.0"
  },
  "devDependencies": {
    "playwright-core": "^1.56.1",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.2.7"
  }
}
